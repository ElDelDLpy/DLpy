"Apple أولًا"

msgid ""
"  Opcionales (--config K=V; todos apagados salvo THREADS): THREADS=4, "
"SUBS=es,en, SUBAUTO=1, THUMB=1, META=1,\n  COOKIES=cookies.txt, DEBUG=1 "
